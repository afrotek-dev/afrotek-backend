# ---------- Base images ----------
FROM node:20 AS base
WORKDIR /app

# ---------- Builder ----------
FROM base AS builder

# Manifests first (cache)
COPY services/product-service/package*.json services/product-service/
COPY libs/common/package*.json libs/common/

# Build shared lib
WORKDIR /app/libs/common
RUN npm install --legacy-peer-deps
COPY libs/common/ /app/libs/common/
RUN npm run build

# Build service
WORKDIR /app/services/product-service
RUN npm install --legacy-peer-deps
COPY services/product-service/ /app/services/product-service/
RUN npm run build

# ---------- Runtime ----------
FROM node:20-alpine AS runtime
WORKDIR /app

COPY --from=builder /app/services/product-service/dist /app/dist
COPY services/product-service/package*.json /app/

RUN npm ci --omit=dev --legacy-peer-deps || npm install --omit=dev --legacy-peer-deps

ENV NODE_ENV=production \
    PORT=3002
EXPOSE 3002
CMD ["node", "dist/main.js"]
